# Get this from https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=your-discord-bot-token

# Get this from https://discord.com/developers/applications -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=your-application-id

# Optional: set this to your server's ID while testing for instant command updates.
# Leave blank to register commands globally (takes up to ~1 hour to propagate everywhere).
DISCORD_GUILD_ID=

# Get this free (no credit card) from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Optional: Google renames/retires models fairly often. Default below is an
# auto-updating alias that should keep working without you needing to touch this.
# If you ever get a "model no longer available" error again, see the README
# for how to find the current model name in under a minute.
GEMINI_MODEL=gemini-flash-latest

# Used only for the health-check endpoint (needed to run on Render's free web service tier)
PORT=3000
